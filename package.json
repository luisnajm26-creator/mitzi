{
  "name": "mitzi",
  "productName": "Mitzi",
  "version": "0.2.1",
  "description": "Lector de EPUB y PDF de código abierto, con biblioteca 3D estilo selector de videojuegos.",
  "license": "MIT",
  "author": "Luis Angel Lopez",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs && node node_modules/electron/install.js",
    "dev": "vite",
    "electron:dev": "node scripts/dev-electron.mjs",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "typecheck": "tsc -b && tsc -p electron/tsconfig.json --noEmit",
    "electron": "electron .",
    "demo": "node scripts/generar-libros-demo.mjs",
    "android": "node scripts/android.mjs",
    "llave": "node scripts/crear-llave.mjs",
    "instalador": "npm run build && electron-builder --win --publish never",
    "publicar": "node scripts/publicar.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@react-three/fiber": "^9.8.2",
    "dexie": "^4.4.6",
    "hyphen": "^1.14.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "io.github.luisnajm26creator.mitzi",
    "productName": "Mitzi",
    "copyright": "© Luis Angel Lopez · Licencia MIT",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mitzi",
      "artifactName": "Mitzi-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
